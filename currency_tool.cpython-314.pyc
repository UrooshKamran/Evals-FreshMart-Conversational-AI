"""
calculator_tool.py
FreshMart Calculator Tool

Evaluates mathematical expressions safely.
No external API needed — runs entirely locally.

Useful for: price calculations, quantity math, discount calculations.
"""

import re
import logging

logger = logging.getLogger(__name__)

# Only allow safe math characters
SAFE_PATTERN = re.compile(r'^[\d\s\+\-\*\/\.\(\)\%\^]+$')


def _safe_eval(expression: str) -> float:
    """Safely evaluate a math expression using only allowed operations."""
    # Replace ^ with ** for exponentiation
    expr = expression.replace("^", "**").replace("%", "/100")

    # Validate against safe pattern
    if not SAFE_PATTERN.match(expr.replace("**", "  ")):
        raise ValueError("Expression contains invalid characters")

    # Use compile + eval with restricted builtins
    code = compile(expr, "<string>", "eval")
    allowed_names = {"__builtins__": {}}
    result = eval(code, allowed_names)
    return float(result)


def calculate(expression: str) -> dict:
    """
    Evaluate a mathematical expression.

    Args:
        expression: Math expression string, e.g. "2 * 3.50 + 1.80"

    Returns:
        dict with the result or error message.
    """
    if not expression or not expression.strip():
        return {"error": "Expression is required"}

    expr = expression.strip()

    try:
        result = _safe_eval(expr)

        # Format result nicely
        if result == int(result):
            formatted = str(int(result))
        else:
            formatted = f"{result:.2f}"

        return {
            "status":     "ok",
            "expression": expr,
            "result":     result,
            "formatted":  formatted
        }

    except ZeroDivisionError:
        return {"error": "Division by zero is not allowed"}
    except ValueError as e:
        return {"error": f"Invalid expression: {str(e)}"}
    except Exception as e:
        logger.error(f"[Calculator] Error evaluating '{expr}': {e}")
        return {"error": f"Could not calculate: {str(e)}"}


CALCULATOR_TOOL_SCHEMA = {
    "name": "calculate",
    "description": (
        "Evaluate a mathematical expression and return the result. Call this when the user "
        "asks for exact price calculations, totals, discounts, or any arithmetic."
    ),
    "parameters": {
        "expression": {
            "type": "string",
            "description": "Math expression to evaluate, e.g. '3 * 2.50 + 1.80' or '(5.00 * 0.9)'"
        }
    },
    "required": ["expression"]
}


if __name__ == "__main__":
    tests = [
        "3 * 2.50 + 1.80",
        "15.50 * 0.85",
        "(2.50 + 1.80 + 3.50) * 2",
        "100 / 4",
        "2 ^ 3",
    ]
    for t in tests:
        print(f"  {t} = {calculate(t)}")
